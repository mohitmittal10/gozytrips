# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# firebase
firebase-debug.log
firestore-debug.log

# token tracking (local filesystem — not for serverless prod)
.token-usage.json

# supabase CLI local/temp state (project refs, pooler URLs)
supabase/.temp/

# large dumps / exports / lighthouse / scratch
WanderLabs_Mock_Backup.json
report2.json
figma_node.json
scratch/
scripts/archive/

# ad-hoc one-off root scripts (archived under scripts/archive when needed)
/add_themes.js
/fix-*.js
/replace-colors.js
/update_pdf.js
/test-index.ts
